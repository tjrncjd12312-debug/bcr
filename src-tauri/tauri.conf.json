{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartHelper",
  "version": "1.3.4",
  "identifier": "com.bcr.predictor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "maximizable": true,
        "title": "SmartHelper",
        "width": 1400,
        "minWidth": 300,
        "minHeight": 400,
        "center": true,
        "decorations": true,
        "devtools": true,
        "transparent": false,
        "theme": "Dark",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://bcra.store https://bcra.store https://*.evolutiongaming.com wss://*.evolutiongaming.com https://*.uat1.evo-games.com wss://*.uat1.evo-games.com"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Copyright © 2024 BCR Team",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "SmartHelper - Multi-Room Baccarat Predictor Desktop Edition",
    "shortDescription": "SmartHelper",
    "macOS": {
      "entitlements": null,
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}